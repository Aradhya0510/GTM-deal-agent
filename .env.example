# ============================================================
# Databricks Agent Configuration
# ============================================================
# Copy this file to .env and fill in your values.
# These environment variables are used by:
#   - deployment/agent.py (on Model Serving, set via agents.deploy() environment_vars)
#   - showcase/backend.py (on Databricks Apps, set via app.yaml env or auto-injected)
#   - deployment/log_and_deploy_notebook.py (hardcoded — edit the notebook directly)
#   - deployment/lakebase_memory_setup.py (hardcoded — edit the notebook directly)
#
# On Model Serving: set via environment_vars in agents.deploy()
# On Databricks Apps: set via app.yaml env section or auto-injected by runtime
# For notebooks: edit the variables at the top of the file directly

# ── Workspace ──
DATABRICKS_HOST=https://your-workspace.cloud.databricks.com
DATABRICKS_WORKSPACE_ID=0000000000000000

# ── Unity Catalog ──
UC_CATALOG=your_catalog
UC_SCHEMA=your_schema

# ── LLM Endpoints ──
LLM_ENDPOINT=databricks-claude-sonnet-4-6
MEMORY_LLM_ENDPOINT=databricks-claude-haiku-4-5
DATABRICKS_EMBEDDING_ENDPOINT=databricks-gte-large-en

# ── Lakebase Postgres (Memory) ──
LAKEBASE_INSTANCE_NAME=your-lakebase-instance
# For Model Serving only (agents.deploy() creates ephemeral SPs that can't auth to Lakebase):
LAKEBASE_PAT=dapi...your-pat-here
# Or if using Lakebase Autoscaling instead of Provisioned:
# LAKEBASE_AUTOSCALING_ENDPOINT=your-autoscaling-endpoint

# ── SQL Warehouse (for audit table only) ──
SQL_WAREHOUSE_ID=your-warehouse-id

# ── Vector Search ──
VS_ENDPOINT_NAME=your-vs-endpoint

# ── Agent Serving Endpoint ──
GTM_ENDPOINT=your-serving-endpoint-name

# ── MLflow ──
MLFLOW_EXPERIMENT_NAME=/Users/your-username/your-experiment

# ── Secrets (for agents.deploy() environment_vars) ──
# Format: {{secrets/your-scope/your-key}}
# LAKEBASE_PAT={{secrets/your-scope/your-pat-key}}
