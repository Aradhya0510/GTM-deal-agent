# ============================================================
# Databricks Agent — Local Deployment Config
# ============================================================
# Copy this file to .env and fill in your values. .env is gitignored.
#
# Consumed by the deploy scripts at the repo root:
#   ./showcase/deploy.sh         — Mission Control showcase Streamlit app
#   ./app/deploy.sh              — Main GTM v2 Command Center Streamlit app
#   ./deployment/deploy_agent.sh — Log + deploy the agent to Model Serving
#   ./deployment/deploy_lakebase.sh — Seed demo data into Lakebase Postgres
#
# Each script reads .env, renders the necessary app.yaml / job spec /
# notebook widget parameters, and runs `databricks` CLI calls. The Python
# sources in the repo are sanitized — they read everything from os.environ
# (apps) or dbutils.widgets (notebooks), populated at deploy time.

# ── Databricks CLI profile ──
DATABRICKS_PROFILE=your-profile-name

# ── Workspace ──
DATABRICKS_HOST=https://your-workspace.cloud.databricks.com
DATABRICKS_WORKSPACE_ID=0000000000000000
WORKSPACE_USER=you@yourcompany.com

# ── Unity Catalog ──
UC_CATALOG=your_catalog
UC_SCHEMA=your_schema

# ── LLM Endpoints ──
LLM_ENDPOINT=databricks-claude-sonnet-4-6
MEMORY_LLM_ENDPOINT=databricks-claude-haiku-4-5
DATABRICKS_EMBEDDING_ENDPOINT=databricks-gte-large-en

# ── Lakebase Postgres (Memory) ──
LAKEBASE_INSTANCE_NAME=your-lakebase-instance
LAKEBASE_DATABASE_NAME=databricks_postgres
# For Model Serving only — agents.deploy() creates ephemeral SPs that
# can't auth to Lakebase, so we pass a PAT via Databricks secrets.
# See CLAUDE.md learning #18 for the full explanation.
LAKEBASE_PAT_SECRET_SCOPE=your-secret-scope
LAKEBASE_PAT_SECRET_KEY=your-secret-key

# ── SQL Warehouse (for audit table only) ──
SQL_WAREHOUSE_ID=your-warehouse-id

# ── Vector Search ──
VS_ENDPOINT_NAME=your-vs-endpoint

# ── Agent Serving Endpoint ──
GTM_ENDPOINT=your-serving-endpoint-name

# ── MLflow ──
MLFLOW_EXPERIMENT_NAME=/Users/you@yourcompany.com/your-experiment

# ── Showcase Mission Control App ──
APP_NAME=mission-control
APP_WORKSPACE_PATH=/Workspace/Users/you@yourcompany.com/mission-control

# ── Main GTM v2 Command Center App ──
MAIN_APP_NAME=gtm-deal-intelligence
MAIN_APP_WORKSPACE_PATH=/Workspace/Users/you@yourcompany.com/servicenow-gtm-agent
MAIN_APP_URL=https://your-app-name-WORKSPACE_ID.aws.databricksapps.com

# ── Agent notebook workspace path ──
# Where deploy_agent.sh and deploy_lakebase.sh upload agent.py + notebooks.
AGENT_NOTEBOOK_WORKSPACE_PATH=/Workspace/Users/you@yourcompany.com/servicenow-gtm-agent
